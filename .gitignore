# Publish only the runnable product and its regression tests.
# Research, proposals, review records and Markdown stay local.
*
!/.gitignore
!/.env.example
!/pyproject.toml
!/uv.lock

!/aml_qc/
!/aml_qc/*.py

!/config/
!/config/schema/
!/config/schema/S1.0.json
!/config/prompts/
!/config/prompts/v2.10/
!/config/prompts/v2.10/*.txt
!/config/prompts/v2.17/
!/config/prompts/v2.17/*.txt
!/config/prompts/v2.18/
!/config/prompts/v2.18/*.txt
!/config/prompts/v2.19/
!/config/prompts/v2.19/*.txt
!/config/prompts/v2.20/
!/config/prompts/v2.20/*.txt
!/config/prompts/v2.21/
!/config/prompts/v2.21/*.txt
!/config/prompts/v2.22/
!/config/prompts/v2.22/*.txt
!/config/prompts/v2.23/
!/config/prompts/v2.23/*.txt
!/config/prompts/v2.24/
!/config/prompts/v2.24/*.txt
!/config/prompts/b0-v1/
!/config/prompts/b0-v1/*.txt

!/data/
!/data/synthetic/
!/data/synthetic/seed-*.json

!/web/
!/web/index.html
!/web/app.js
!/web/style.css

!/scripts/
!/scripts/export_case.py
!/scripts/prepare_reference_workpack.py
!/scripts/validate_evaluation.py
!/scripts/score_evaluation.py
!/scripts/run_evaluation.py
!/scripts/generate_heldout.py
!/scripts/score_heldout.py

!/tests/
!/tests/test_*.py
/tests/test_authoring_preparation.py
/tests/test_case_assembly.py

# These exclusions apply even if a directory is allowed above.
**/*.[mM][dD]
**/*.[mM][aA][rR][kK][dD][oO][wW][nN]
**/[Rr][Ee][Aa][Dd][Mm][Ee]*
**/.env
**/.env.*
!/.env.example
**/__pycache__/
**/*.pyc
**/*.sqlite3
**/*.sqlite3-*
**/.DS_Store
